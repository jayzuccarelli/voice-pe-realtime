  "type": "function",
  "name": "todo_get_items",
  "description": "Query a to-do list to find out what items are on it. Use this to answer questions like 'What's on my task list?' or 'Read my grocery list'. Filters items by status (needs_action, completed, all).",
  "parameters": {
   "type": "object",
   "properties": {
    "todo_list": {
     "type": "string",
     "enum": [
      "Shopping List"
     ]
    },
    "status": {
     "type": "string",
     "enum": [
      "needs_action",
      "completed",
      "all"
     ],
     "description": "Filter returned items by status, by default returns incomplete items",
     "default": "needs_action"
    }
   }
  }
 },
 {
  "type": "function",
  "name": "tv_launch_app",
  "description": "Open a streaming app on a TV: Netflix, Hulu, YouTube, Disney+, Prime Video, Spotify, Apple TV or Max, on the living room TV or the bedroom TV. Turns the TV on first if it is off. Use this whenever the user asks to put on, open, launch or watch an app on a TV.. Aliases: ['TV — Launch App']",
  "parameters": {
   "type": "object",
   "properties": {
    "room": {
     "type": "string",
     "enum": [
      "living room",
      "bedroom"
     ],
     "description": "Which TV — the living room TV or the bedroom TV"
    },
    "app": {
     "type": "string",
     "enum": [
      "Netflix",
      "Hulu",
      "YouTube",
      "Disney+",
      "Prime Video",
      "Spotify",
      "Apple TV",
      "Max"
     ],
     "description": "Which streaming app to open"
    }
   }
  }
 },
 {
  "type": "function",
  "name": "tv_remote",
  "description": "Control a TV the way the physical remote does: change channel (up, down or to a specific number), play, pause, stop, fast forward, rewind, volume up or down, mute, move around the on-screen menu (up, down, left, right, select, back, home, guide, menu, info) and switch input. Works on the living room TV and the bedroom TV. Use this for anything that is not turning the TV on/off or opening a streaming app.. Aliases: ['TV — Remote Control']",
  "parameters": {
   "type": "object",
   "properties": {
    "room": {
     "type": "string",
     "enum": [
      "living room",
      "bedroom"
     ],
     "description": "Which TV — the living room TV or the bedroom TV"
    },
    "action": {
     "type": "string",
     "enum": [
      "channel up",
      "channel down",
      "channel",
      "play",
      "pause",
      "stop",
      "fast forward",
      "rewind",
      "volume up",
      "volume down",
      "mute",
      "up",
      "down",
      "left",
      "right",
      "select",
      "back",
      "home",
      "menu",
      "guide",
      "info",
      "exit",
      "source"
     ],
     "description": "What the remote should do"
    },
    "channel": {
     "type": "number",
     "minimum": 1.0,
     "maximum": 9999.0,
     "description": "Channel number, only used when action is \"channel\""
    },
    "repeats": {
     "type": "number",
     "minimum": 1.0,
     "maximum": 20.0,
     "description": "How many times to send it, for example volume up 5 times"
    }
   }
  }
 },
 {
